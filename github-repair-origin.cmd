@echo off\r\nsetlocal EnableExtensions DisableDelayedExpansion\r\ncd /d "%~dp0"\r\ntitle PipeMark Studio - Repair Git Origin\r\n\r\necho ==============================================================\r\necho PipeMark Studio - Repair existing GitHub remote and publish\r\necho ==============================================================\r\necho.\r\n\r\nwhere git.exe >nul 2>nul\r\nif errorlevel 1 (\r\n  echo [ERROR] Git was not found.\r\n  pause\r\n  exit /b 1\r\n)\r\n\r\ngit remote | findstr /x /c:"origin" >nul 2>nul\r\nif errorlevel 1 (\r\n  echo [INFO] origin is missing. It will be added by the publisher.\r\n) else (\r\n  echo [OK] origin already exists.\r\n)\r\n\r\ncall "%~dp0github-bootstrap.cmd"\r\nexit /b %ERRORLEVEL%\r\n